# Tests listChildren operation on two nodes with bidirectional edges to each other

# Create graph
created graph bison

# Add nodes
added node cow to bison
added node pig to bison

# Add edges
added edge cowTopig from cow to pig in bison
added edge pigToCow from pig to cow in bison

# Print out children of each
the children of cow in bison are: pig(cowToPig)
the children of pig in bison are: cow(pigToCow)
